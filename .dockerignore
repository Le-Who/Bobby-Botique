# ── Version Control ───────────────────────────────────────────
.git/
.github/
.gitignore

# ── IDE & Editor Configs ──────────────────────────────────────
.vscode/
.cursor/
.Jules/
.idea/
.roomodes

# ── Virtual Environment ──────────────────────────────────────
.venv/
venv/

