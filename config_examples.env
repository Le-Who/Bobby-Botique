# ========================================
# ПРИМЕРЫ КОНФИГУРАЦИИ GEMAI BOT
# ========================================
# Скопируйте нужные строки в ваш .env файл

# ========================================
# РЕЖИМЫ БЕЗОПАСНОСТИ
# ========================================

# 🔒 Стандартные настройки (рекомендуется)
SAFETY_MODE=standard

# 🟡 Расслабленные настройки (меньше блокировок)
SAFETY_MODE=relaxed

# 🟢 Отключенные настройки (только для тестирования)
SAFETY_MODE=disabled

# 🔴 Агрессивные настройки (больше блокировок)
SAFETY_MODE=aggressive

# 🔄 Автоматический режим (умное переключение)
SAFETY_MODE=auto

# ========================================
# ОТЛАДКА И ЛОГИРОВАНИЕ
# ========================================

# Включить режим отладки
DEBUG_MODE=true

# Уровень логирования
LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR

# Логировать решения по безопасности
LOG_SAFETY_DECISIONS=true

# ========================================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ========================================

# Включить кэширование
ENABLE_CACHE=true

# Время жизни кэша (часы)
CACHE_TTL_HOURS=72

# Максимальное количество попыток
MAX_RETRIES=3

# Таймаут запросов (секунды)
REQUEST_TIMEOUT_SECONDS=60

# ========================================
# ФУНКЦИИ
# ========================================

# Автоматическое переключение настроек безопасности
ENABLE_SAFETY_FALLBACK=true

# Упрощение проблемных промптов
ENABLE_PROMPT_SIMPLIFICATION=true

# Отключение system_instruction при проблемах
ENABLE_SYSTEM_INSTRUCTION_FALLBACK=true

# ========================================
# ПРИМЕРЫ КОНФИГУРАЦИЙ ДЛЯ РАЗНЫХ СЦЕНАРИЕВ
# ========================================

# 🚀 Продакшен (рекомендуется)
# SAFETY_MODE=standard
# DEBUG_MODE=false
# LOG_LEVEL=INFO
# ENABLE_SAFETY_FALLBACK=true

# 🧪 Тестирование
# SAFETY_MODE=relaxed
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# ENABLE_SAFETY_FALLBACK=true

# 🔧 Отладка проблем
# SAFETY_MODE=disabled
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# ENABLE_SAFETY_FALLBACK=false
# ENABLE_PROMPT_SIMPLIFICATION=false

# 🛡️ Максимальная безопасность
# SAFETY_MODE=aggressive
# DEBUG_MODE=false
# LOG_LEVEL=WARNING
# ENABLE_SAFETY_FALLBACK=false

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL - для персистентной очереди задач)
# =============================================================================

# Локальный Redis (по умолчанию)
# REDIS_URL=redis://localhost:6379

# Upstash.com (бесплатный тариф: 10k запросов/день, 256MB RAM)
# Получите URL на https://console.upstash.com/
# REDIS_URL=redis://default:password@us1-capable-rat-12345.upstash.io:12345

# DigitalOcean Managed Redis
# REDIS_URL=redis://default:password@redis-12345.us-east-1-1.ondigitalocean.com:12345

# Azure Cache for Redis
# REDIS_URL=redis://:password@hostname.redis.cache.windows.net:6380

# AWS ElastiCache
# REDIS_URL=redis://hostname.cache.amazonaws.com:6379

# Включить персистентную очередь (требует Redis)
ENABLE_PERSISTENT_QUEUE=false
