# Оптимизированный Dockerfile для Northflank.com
FROM python:3.11-slim

# Устанавливаем системные зависимости и очищаем кэш
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем рабочую директорию
WORKDIR /app

# Создаем non-root пользователя для безопасности
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app

# Копируем файл с зависимостями
COPY requirements.txt .

# Устанавливаем зависимости
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код
COPY . .

# Создаем улучшенный скрипт для запуска
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'echo "=== BOT STARTUP SCRIPT ==="' >> /app/start.sh && \
    echo 'echo "Container ID: $HOSTNAME"' >> /app/start.sh && \
    echo 'echo "Process ID: $$"' >> /app/start.sh && \
    echo 'echo "Timestamp: $(date)"' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Очистка старых блокировок' >> /app/start.sh && \
    echo 'echo "Cleaning up old locks..."' >> /app/start.sh && \
    echo 'find /tmp -name "*.lock" -delete 2>/dev/null || true' >> /app/start.sh && \
    echo 'echo "Lock cleanup completed"' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Проверка переменных окружения' >> /app/start.sh && \
    echo 'echo "Checking environment variables..."' >> /app/start.sh && \
    echo 'if [ -z "$TELEGRAM_BOT_TOKEN" ]; then' >> /app/start.sh && \
    echo '    echo "ERROR: TELEGRAM_BOT_TOKEN not set"' >> /app/start.sh && \
    echo '    exit 1' >> /app/start.sh && \
    echo 'fi' >> /app/start.sh && \
    echo 'if [ -z "$DATABASE_URL" ]; then' >> /app/start.sh && \
    echo '    echo "ERROR: DATABASE_URL not set"' >> /app/start.sh && \
    echo '    exit 1' >> /app/start.sh && \
    echo 'fi' >> /app/start.sh && \
    echo 'echo "Environment variables OK"' >> /app/start.sh && \
    echo '' >> /app/start.sh && \
    echo '# Запуск бота' >> /app/start.sh && \
    echo 'echo "Starting bot..."' >> /app/start.sh && \
    echo 'exec python /app/bot.py' >> /app/start.sh && \
    chmod +x /app/start.sh

# Настраиваем переменные окружения
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Передаем права пользователю app
RUN chown -R app:app /app
USER app

# Команда для запуска бота
CMD ["/app/start.sh"]
